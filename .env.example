# Copy to .env and fill in. Never commit .env.

# MongoDB (Atlas connection string)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db>

# Redis (Upstash). TLS is always enabled.
REDIS_HOST=<your-db>.upstash.io
REDIS_PORT=6379
REDIS_PASSWORD=<your Upstash Redis password>

# Cloudinary
CLOUDINARY_CLOUD_NAME=<your cloud name>
CLOUDINARY_API_KEY=<your API key>
CLOUDINARY_API_SECRET=<your API secret>

# HTTP port (API defaults to 3000, worker health listener to 3001)
PORT=3000

# Jobs one worker process runs at the same time (default 2)
WORKER_CONCURRENCY=2
